{
  "name": "simplified-billing-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop client for the Simplified Billing & Inventory Management System",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names renderer,desktop \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && cross-env BILLING_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "8.1.5",
    "wait-on": "^9.0.1"
  }
}
